{
  // Playwright files run in Node, not the browser: their own project, so
  // Node types (process, Buffer) never reach app/ code (web/tsconfig.json).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["./**/*.ts", "../playwright.config.ts"]
}

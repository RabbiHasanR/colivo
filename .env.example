# Copy to .env for local development. Never commit .env.
# Placeholder values only; use your own password.

# PostgreSQL container (compose.yaml)
POSTGRES_USER=colivo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=colivo
POSTGRES_PORT=5432

# Redis container (compose.yaml)
REDIS_PORT=6379

# Backend container (compose.yaml)
BACKEND_PORT=8000

# Backend settings (backend/app/core/config.py). Hosts are localhost for
# running on the host; the backend container overrides them in compose.yaml.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://colivo:change-me@localhost:5432/colivo
# The database name must match infra/postgres/init/01-create-test-db.sql.
TEST_DATABASE_URL=postgresql+psycopg://colivo:change-me@localhost:5432/colivo_test
REDIS_URL=redis://localhost:6379/0
# Optional. Tests use this Redis database and empty it after each test;
# unset, they use database 15 of REDIS_URL's server.
# TEST_REDIS_URL=redis://localhost:6379/15
# Seconds a PostgreSQL or Redis connection may take before it counts as down.
CONNECT_TIMEOUT_SECONDS=2
# Comma-separated origins allowed to call the API from a browser.
BACKEND_CORS_ORIGINS=http://localhost:4200
# Send the session cookie over HTTPS only. false for http://localhost; true
# (the default when unset) everywhere else.
SESSION_COOKIE_SECURE=false
# How one-time codes and notices are sent. Only "log" for now: the backend
# logs each message and keeps it in the Redis list dev:outbox.
NOTIFIER=log

# Web (web/.env.development). Where the browser calls the API.
VITE_API_HOST=http://localhost:8000

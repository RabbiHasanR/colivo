{
  "openapi": "3.1.0",
  "info": {
    "title": "Colivo",
    "description": "Colivo REST API: meals, groceries, rent and bills for shared homes.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Get Health",
        "description": "Report whether the backend can reach the database and Redis.",
        "operationId": "get_health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse_HealthOut_"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse_HealthOut_"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/codes": {
      "post": {
        "tags": [
          "Accounts"
        ],
        "summary": "Request Code",
        "description": "Send a one-time code by SMS or email; the same answer for any contact.",
        "operationId": "request_code_api_v1_auth_codes_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CodeRequestIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse_CodeSentOut_"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse_CodeErrorOut_"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse_CodeErrorOut_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/sign-up": {
      "post": {
        "tags": [
          "Accounts"
        ],
        "summary": "Sign Up",
        "description": "Create a home; the person signing up becomes its owner and is logged in.",
        "operationId": "sign_up_api_v1_auth_sign_up_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignUpIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse_MeOut_"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse_CodeErrorOut_"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse_CodeErrorOut_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/log-in": {
      "post": {
        "tags": [
          "Accounts"
        ],
        "summary": "Log In",
        "description": "Log in with a phone or email and its one-time code.",
        "operationId": "log_in_api_v1_auth_log_in_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogInIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse_MeOut_"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse_CodeErrorOut_"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse_CodeErrorOut_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/log-out": {
      "post": {
        "tags": [
          "Accounts"
        ],
        "summary": "Log Out",
        "description": "End the session and clear its cookie.",
        "operationId": "log_out_api_v1_auth_log_out_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "Accounts"
        ],
        "summary": "Get Me",
        "description": "Who is logged in, and in which home; renews the cookie for 30 days.",
        "operationId": "get_me_api_v1_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse_MeOut_"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Accounts"
        ],
        "summary": "Update Me",
        "description": "Fix your own name; this also finishes the first log-in check.",
        "operationId": "update_me_api_v1_me_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MeUpdateIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse_MeOut_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/members": {
      "get": {
        "tags": [
          "Accounts"
        ],
        "summary": "List Members",
        "description": "Everyone in the home, for the owner and managers.",
        "operationId": "list_members_api_v1_members_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse_list_MemberOut__",
                  "items": {
                    "$ref": "#/components/schemas/MemberOut"
                  },
                  "type": "array",
                  "title": "Response List Members Api V1 Members Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Accounts"
        ],
        "summary": "Add Member",
        "description": "Add a member to the home; they get an SMS or email to log in.",
        "operationId": "add_member_api_v1_members_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemberIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse_MemberOut_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/members/{member_id}": {
      "patch": {
        "tags": [
          "Accounts"
        ],
        "summary": "Update Member",
        "description": "Change a member's name or join date.",
        "operationId": "update_member_api_v1_members__member_id__patch",
        "parameters": [
          {
            "name": "member_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Member Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemberUpdateIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse_MemberOut_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/home/setup": {
      "get": {
        "tags": [
          "Homes"
        ],
        "summary": "Get Setup",
        "description": "The setup checklist of the logged-in owner's or manager's home.",
        "operationId": "get_setup_api_v1_home_setup_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse_SetupOut_"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Channel": {
        "type": "string",
        "enum": [
          "sms",
          "email"
        ],
        "title": "Channel",
        "description": "How a message reaches a person."
      },
      "CodeErrorOut": {
        "properties": {
          "reason": {
            "$ref": "#/components/schemas/CodeErrorReason"
          },
          "tries_left": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tries Left"
          },
          "retry_in_seconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retry In Seconds"
          }
        },
        "type": "object",
        "required": [
          "reason"
        ],
        "title": "CodeErrorOut",
        "description": "The ``data`` of a refused code: why, and what the person can do next."
      },
      "CodeErrorReason": {
        "type": "string",
        "enum": [
          "wrong",
          "expired",
          "locked",
          "too_soon",
          "hourly_limit"
        ],
        "title": "CodeErrorReason",
        "description": "Why a one-time code, or a new one, was refused (FR-94)."
      },
      "CodeRequestIn": {
        "properties": {
          "contact": {
            "type": "string",
            "description": "A phone number or an email"
          }
        },
        "type": "object",
        "required": [
          "contact"
        ],
        "title": "CodeRequestIn",
        "description": "Ask for a one-time code for a phone or email."
      },
      "CodeSentOut": {
        "properties": {
          "channel": {
            "$ref": "#/components/schemas/Channel"
          },
          "expires_in_seconds": {
            "type": "integer",
            "title": "Expires In Seconds"
          },
          "resend_in_seconds": {
            "type": "integer",
            "title": "Resend In Seconds"
          }
        },
        "type": "object",
        "required": [
          "channel",
          "expires_in_seconds",
          "resend_in_seconds"
        ],
        "title": "CodeSentOut",
        "description": "How the code was sent and how long it works; the same for any contact."
      },
      "Contact": {
        "properties": {
          "channel": {
            "$ref": "#/components/schemas/Channel"
          },
          "value": {
            "type": "string",
            "title": "Value"
          }
        },
        "type": "object",
        "required": [
          "channel",
          "value"
        ],
        "title": "Contact",
        "description": "A phone (E.164) or an email address (lower case), and how to reach it."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthOut": {
        "properties": {
          "database": {
            "$ref": "#/components/schemas/ServiceStatus"
          },
          "redis": {
            "$ref": "#/components/schemas/ServiceStatus"
          }
        },
        "type": "object",
        "required": [
          "database",
          "redis"
        ],
        "title": "HealthOut",
        "description": "The status of each dependency the backend needs."
      },
      "LogInIn": {
        "properties": {
          "contact": {
            "type": "string",
            "description": "A phone number or an email"
          },
          "code": {
            "type": "string",
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "contact",
          "code"
        ],
        "title": "LogInIn",
        "description": "Log in with a phone or email and the code sent to it."
      },
      "MeHomeOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "area": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Area"
          },
          "first_month": {
            "type": "string",
            "format": "date",
            "title": "First Month"
          }
        },
        "type": "object",
        "required": [
          "id",
          "code",
          "name",
          "area",
          "first_month"
        ],
        "title": "MeHomeOut",
        "description": "The logged-in person's home."
      },
      "MeMembershipOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "status": {
            "$ref": "#/components/schemas/MembershipStatus"
          },
          "joined_on": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Joined On"
          },
          "added_by_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Added By Name"
          },
          "details_checked": {
            "type": "boolean",
            "title": "Details Checked",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "role",
          "status"
        ],
        "title": "MeMembershipOut",
        "description": "The logged-in person's membership of their home."
      },
      "MeOut": {
        "properties": {
          "person": {
            "$ref": "#/components/schemas/MePersonOut"
          },
          "membership": {
            "$ref": "#/components/schemas/MeMembershipOut"
          },
          "home": {
            "$ref": "#/components/schemas/MeHomeOut"
          }
        },
        "type": "object",
        "required": [
          "person",
          "membership",
          "home"
        ],
        "title": "MeOut",
        "description": "Who is logged in, and in which home."
      },
      "MePersonOut": {
        "properties": {
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          }
        },
        "type": "object",
        "required": [
          "phone"
        ],
        "title": "MePersonOut",
        "description": "The logged-in person's log-in identity."
      },
      "MeUpdateIn": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "MeUpdateIn",
        "description": "Fix your own name; sending it also finishes the first log-in check."
      },
      "MemberIn": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "contact": {
            "type": "string",
            "description": "A phone number or an email"
          },
          "joined_on": {
            "type": "string",
            "format": "date",
            "title": "Joined On"
          },
          "role": {
            "type": "string",
            "enum": [
              "member",
              "manager"
            ],
            "title": "Role",
            "default": "member"
          }
        },
        "type": "object",
        "required": [
          "name",
          "contact",
          "joined_on"
        ],
        "title": "MemberIn",
        "description": "Add a member: who, how to reach them, from when, and their role."
      },
      "MemberOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "status": {
            "$ref": "#/components/schemas/MembershipStatus"
          },
          "joined_on": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Joined On"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "phone",
          "email",
          "role",
          "status",
          "joined_on"
        ],
        "title": "MemberOut",
        "description": "A member of the home, for the owner and managers' members list."
      },
      "MemberUpdateIn": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "joined_on": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Joined On"
          }
        },
        "type": "object",
        "title": "MemberUpdateIn",
        "description": "Change a member's name or join date; leave out what stays the same."
      },
      "MembershipStatus": {
        "type": "string",
        "enum": [
          "active",
          "inactive"
        ],
        "title": "MembershipStatus",
        "description": "Whether a member may log in now."
      },
      "Role": {
        "type": "string",
        "enum": [
          "owner",
          "manager",
          "member"
        ],
        "title": "Role",
        "description": "A member's role in their home (specs/data-model.md → Roles)."
      },
      "ServiceStatus": {
        "type": "string",
        "enum": [
          "ok",
          "down"
        ],
        "title": "ServiceStatus",
        "description": "Whether a dependency of the backend answered."
      },
      "SetupOut": {
        "properties": {
          "steps": {
            "items": {
              "$ref": "#/components/schemas/SetupStep"
            },
            "type": "array",
            "title": "Steps"
          }
        },
        "type": "object",
        "required": [
          "steps"
        ],
        "title": "SetupOut",
        "description": "The new-home checklist, in order."
      },
      "SetupStep": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "done": {
            "type": "boolean",
            "title": "Done"
          }
        },
        "type": "object",
        "required": [
          "key",
          "done"
        ],
        "title": "SetupStep",
        "description": "One step of the new-home checklist (FR-95)."
      },
      "SignUpIn": {
        "properties": {
          "contact": {
            "type": "string",
            "description": "A phone number or an email"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "home_name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Home Name"
          },
          "area": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Area"
          },
          "first_month": {
            "type": "string",
            "format": "date",
            "title": "First Month"
          },
          "lives_here": {
            "type": "boolean",
            "title": "Lives Here"
          }
        },
        "type": "object",
        "required": [
          "contact",
          "code",
          "name",
          "home_name",
          "first_month",
          "lives_here"
        ],
        "title": "SignUpIn",
        "description": "The owner's sign-up: who they are, their code and their new home."
      },
      "StandardResponse_CodeErrorOut_": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CodeErrorOut"
              },
              {
                "type": "null"
              }
            ]
